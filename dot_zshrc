zmodload zsh/zprof


#-------------------------------------------------------------------------------
# Powerlevel10k Instant Prompt
#-------------------------------------------------------------------------------
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

#-------------------------------------------------------------------------------
# Completion System
#-------------------------------------------------------------------------------
autoload -Uz compinit
if [ $(date +'%j') != $(stat -f '%Sm' -t '%j' ~/.zcompdump) ]; then
  compinit
else
  compinit -C
fi

#-------------------------------------------------------------------------------
# Environment Variables
#-------------------------------------------------------------------------------
export XDG_CONFIG_HOME="$HOME/.config"
export EDITOR="nvim"
export DISABLE_AUTO_TITLE=true

# Go configuration
export GOPATH=$HOME/go
export GOBIN=$GOPATH/bin
export PATH=$PATH:$GOBIN

# WezTerm
export PATH="$PATH:/Applications/WezTerm.app/Contents/MacOS"

# Fortran configuration
export SDKROOT=$(xcrun --sdk macosx --show-sdk-path)
export CFLAGS="-I/opt/homebrew/opt/libomp/include -Xpreprocessor -fopenmp"
export LDFLAGS="-L/opt/homebrew/opt/libomp/lib -lomp"
export CPPFLAGS="-I/opt/homebrew/opt/openblas/include"
export PKG_CONFIG_PATH="/opt/homebrew/opt/openblas/lib/pkgconfig"

#-------------------------------------------------------------------------------
# Aliases
#-------------------------------------------------------------------------------
alias ll="eza -l"
alias h="nvim"
alias c="chezmoi"
alias s="source ~/.zshrc"
alias -g jqi="jq -R '. as \$line | try (fromjson) catch (\$line + \"\n\" | stderr | empty)';"

#-------------------------------------------------------------------------------
# History Configuration
#-------------------------------------------------------------------------------
HISTFILE=$HOME/.zhistory
SAVEHIST=1000
HISTSIZE=999
setopt share_history
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_verify

#-------------------------------------------------------------------------------
# Key Bindings
#-------------------------------------------------------------------------------
# Expand alias function
globalias() {
   zle _expand_alias
   zle expand-word
   zle self-insert
}
zle -N globalias

# Space expands all aliases, including global
bindkey -M emacs " " globalias
bindkey -M viins " " globalias

# Control-space to make a normal space
bindkey -M emacs "^ " magic-space
bindkey -M viins "^ " magic-space

# Normal space during searches
bindkey -M isearch " " magic-space

#-------------------------------------------------------------------------------
# Lazy Loading Functions
#-------------------------------------------------------------------------------
# PyEnv
export PYENV_ROOT="$HOME/.pyenv"
export PATH="$PYENV_ROOT/bin:$PATH"
pyenv() {
    eval "$(command pyenv init -)"
    pyenv "$@"
}

# Conda
conda() {
    unfunction "$0"
    export PATH="/Users/siewweiheng/miniconda3/bin:$PATH"
    eval "$('/Users/siewweiheng/miniconda3/bin/conda' 'shell.zsh' 'hook')"
    $0 "$@"
}

# kubectl
kubectl() {
    unfunction "$0"
    source <(command kubectl completion zsh)
    $0 "$@"
}

#-------------------------------------------------------------------------------
# External Tools and Plugins
#-------------------------------------------------------------------------------
eval "$(zoxide init zsh --cmd 'cd')"
source $(brew --prefix)/share/powerlevel10k/powerlevel10k.zsh-theme
source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

#-------------------------------------------------------------------------------
# Path Updates
#-------------------------------------------------------------------------------
export PATH="$PATH:/Users/siewweiheng/.local/bin"
export PATH="/opt/homebrew/opt/openjdk@11/bin:$PATH"

#-------------------------------------------------------------------------------
# Google Cloud SDK
#-------------------------------------------------------------------------------
if [ -f '/Users/siewweiheng/Downloads/google-cloud-sdk/path.zsh.inc' ]; then 
  . '/Users/siewweiheng/Downloads/google-cloud-sdk/path.zsh.inc'
fi

if [ -f '/Users/siewweiheng/Downloads/google-cloud-sdk/completion.zsh.inc' ]; then 
  . '/Users/siewweiheng/Downloads/google-cloud-sdk/completion.zsh.inc'
fi

#-------------------------------------------------------------------------------
# Additional Configuration Files
#-------------------------------------------------------------------------------
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
if [[ -f ~/.secrets.zsh ]]; then
  source ~/.secrets.zsh
fi

zprof
