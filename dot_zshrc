#-------------------------------------------------------------------------------
# Powerlevel10k Instant Prompt
#-------------------------------------------------------------------------------
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

#-------------------------------------------------------------------------------
# Completion System - Linux/CachyOS safe
#-------------------------------------------------------------------------------
autoload -Uz compinit

if [[ ! -f ~/.zcompdump || $(date +'%j') != $(date -r ~/.zcompdump +'%j') ]]; then
  compinit
else
  compinit -C
fi

#-------------------------------------------------------------------------------
# Environment Variables
#-------------------------------------------------------------------------------
export XDG_CONFIG_HOME="$HOME/.config"
export EDITOR="nvim"
export VISUAL="nvim"
export DISABLE_AUTO_TITLE=true

# Keep tools that inspect $SHELL aligned with the shell we actually want.
export SHELL="/usr/bin/zsh"

# Local binaries
export PATH="$HOME/.local/bin:$PATH"

# Go
export GOPATH="$HOME/go"
export GOBIN="$GOPATH/bin"
export PATH="$GOBIN:$PATH"

# Pyenv
export PYENV_ROOT="$HOME/.pyenv"
export PATH="$PYENV_ROOT/bin:$PATH"

#-------------------------------------------------------------------------------
# Aliases
#-------------------------------------------------------------------------------
alias ll="eza -l --icons --git"
alias la="eza -la --icons --git"
alias tree="eza --tree --icons"
alias h="nvim"
alias c="chezmoi"
alias ccd='cd "$(chezmoi source-path)"'
alias s="source ~/.zshrc"
alias lg="lazygit"

#-------------------------------------------------------------------------------
# History Configuration
#-------------------------------------------------------------------------------
HISTFILE="$HOME/.zhistory"
SAVEHIST=10000
HISTSIZE=10000

setopt share_history
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_verify
setopt append_history
setopt inc_append_history

#-------------------------------------------------------------------------------
# Key Bindings
#-------------------------------------------------------------------------------
globalias() {
  zle _expand_alias
  zle expand-word
  zle self-insert
}
zle -N globalias

bindkey -M emacs " " globalias
bindkey -M viins " " globalias

bindkey -M emacs "^ " magic-space
bindkey -M viins "^ " magic-space
bindkey -M isearch " " magic-space

#-------------------------------------------------------------------------------
# Lazy Loading Functions
#-------------------------------------------------------------------------------
pyenv() {
  if command -v pyenv >/dev/null 2>&1; then
    eval "$(command pyenv init -)"
    pyenv "$@"
  else
    echo "pyenv is not installed"
    return 127
  fi
}

conda() {
  local conda_bin="$HOME/miniconda3/bin/conda"

  if [[ -x "$conda_bin" ]]; then
    unfunction "$0"
    export PATH="$HOME/miniconda3/bin:$PATH"
    eval "$("$conda_bin" shell.zsh hook)"
    "$0" "$@"
  else
    echo "conda is not installed at $conda_bin"
    return 127
  fi
}

kubectl() {
  if command -v kubectl >/dev/null 2>&1; then
    unfunction "$0"
    source <(command kubectl completion zsh)
    "$0" "$@"
  else
    echo "kubectl is not installed"
    return 127
  fi
}

#-------------------------------------------------------------------------------
# External Tools and Plugins - CachyOS / Arch
#-------------------------------------------------------------------------------
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh --cmd 'cd')"
fi

# Powerlevel10k path differs depending on package source.
if [[ -r /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme ]]; then
  source /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme
elif [[ -r /usr/share/powerlevel10k/powerlevel10k.zsh-theme ]]; then
  source /usr/share/powerlevel10k/powerlevel10k.zsh-theme
elif [[ -r /usr/share/zsh/powerlevel10k/powerlevel10k.zsh-theme ]]; then
  source /usr/share/zsh/powerlevel10k/powerlevel10k.zsh-theme
fi

[[ -r /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && \
  source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh

[[ -r /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && \
  source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

#-------------------------------------------------------------------------------
# Additional Configuration Files
#-------------------------------------------------------------------------------
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh
[[ -f ~/.secrets.zsh ]] && source ~/.secrets.zsh

# pnpm
export PNPM_HOME="/home/weiheng/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end
